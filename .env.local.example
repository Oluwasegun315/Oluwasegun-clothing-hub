# Copy to .env.local and fill from Supabase: Project Settings → API
# This is a website (Next.js); NEXT_PUBLIC_SITE_URL must be your real site URL in production.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Local: http://localhost:3000 — Production: https://your-domain.com (add /auth/callback in Supabase)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
